<style>
.mobile-menu {
  position: fixed;
  top: 0; left: -320px;
  width: 300px;
  height: 100vh;
  background: var(--color-white);
  z-index: 3000;
  overflow-y: auto;
  transition: left 0.3s ease;
  box-shadow: var(--shadow-lg);
  display: flex;
  flex-direction: column;
}
.mobile-menu.open { left: 0; }
.mobile-menu__header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.2rem 1.5rem;
  border-bottom: 1px solid var(--color-border);
}
.mobile-menu__close {
  font-size: 1.8rem;
  background: none;
  border: none;
  cursor: pointer;
  color: var(--color-text);
  line-height: 1;
}
.mobile-menu__search { padding: 1rem 1.5rem; border-bottom: 1px solid var(--color-border); }
.mobile-menu__search input {
  width: 100%;
  padding: 0.65rem 1rem;
  border: 1.5px solid var(--color-border);
  border-radius: var(--radius-xl);
  font-family: inherit;
  font-size: 0.9rem;
  outline: none;
}
.mobile-menu__links { flex: 1; padding: 0.5rem 0; }
.mobile-menu__links li a,
.mobile-menu__links .sub-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.85rem 1.5rem;
  font-size: 1rem;
  font-weight: 500;
  border-bottom: 1px solid rgba(0,0,0,0.04);
  width: 100%;
  background: none;
  border-left: none;
  border-right: none;
  border-top: none;
  font-family: inherit;
  cursor: pointer;
  text-align: left;
}
.mobile-menu__links li a:hover,
.mobile-menu__links .sub-toggle:hover { color: var(--color-primary); background: rgba(232,96,60,0.05); }
.sub-links { background: var(--color-light-gray); }
.sub-links li a { padding-left: 2.5rem; font-size: 0.9rem; }
.mobile-menu__footer { padding: 1.5rem; }
</style>

<script>
  document.querySelector('.menu-toggle')?.addEventListener('click', () => {
    document.querySelector('.mobile-menu').classList.toggle('open');
  });
  document.querySelector('.mobile-menu__close')?.addEventListener('click', () => {
    document.querySelector('.mobile-menu').classList.remove('open');
  });
  document.querySelectorAll('.sub-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      btn.nextElementSibling?.classList.toggle('hidden');
    });
  });
</script>
