<!-- Collection Banner -->
<div class="collection-header-banner">
  <div class="container">
    {%- if collection.image -%}
      <div style="position:relative;overflow:hidden;border-radius:var(--radius-lg);max-width:900px;margin:0 auto 1.5rem;">
        <img src="{{ collection.image | image_url: width: 1200 }}" alt="{{ collection.title }}" style="width:100%;max-height:300px;object-fit:cover;opacity:0.3;">
      </div>
    {%- endif -%}
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <p>{{ collection.description }}</p>
    {%- endif -%}
  </div>
</div>

<div class="collection-page">
  <div class="container">
    <div class="collection-layout">

      <!-- Filters Sidebar -->
      <aside class="filter-panel" aria-label="Product filters">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.2rem;">
          <h3 style="font-size:1rem;font-weight:700;">Filters</h3>
          <a href="{{ collection.url }}" style="font-size:0.85rem;color:var(--color-primary);">Clear all</a>
        </div>

        <!-- Sort (mobile hidden, shown in toolbar) -->
        <div class="filter-group">
          <h4>Sort By</h4>
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <div style="display:flex;flex-direction:column;gap:0.5rem;">
            {%- for option in collection.sort_options -%}
              <label class="filter-option">
                <input type="radio" name="sort_by" value="{{ option.value }}" {% if option.value == sort_by %}checked{% endif %}
                  onchange="window.location='{{ collection.url }}?sort_by='+this.value">
                {{ option.name }}
              </label>
            {%- endfor -%}
          </div>
        </div>

        <!-- Price Range Filter -->
        <div class="filter-group">
          <h4>Price Range</h4>
          <label class="filter-option"><input type="checkbox" value="under500"> Under ₹500</label>
          <label class="filter-option"><input type="checkbox" value="500-1000"> ₹500 – ₹1,000</label>
          <label class="filter-option"><input type="checkbox" value="1000-2500"> ₹1,000 – ₹2,500</label>
          <label class="filter-option"><input type="checkbox" value="over2500"> ₹2,500+</label>
        </div>

        <!-- Gift For -->
        <div class="filter-group">
          <h4>Gift For</h4>
          <label class="filter-option"><input type="checkbox"> Him</label>
          <label class="filter-option"><input type="checkbox"> Her</label>
          <label class="filter-option"><input type="checkbox"> Kids</label>
          <label class="filter-option"><input type="checkbox"> Couples</label>
          <label class="filter-option"><input type="checkbox"> Office</label>
        </div>

        <!-- Availability -->
        <div class="filter-group">
          <h4>Availability</h4>
          <label class="filter-option"><input type="checkbox" checked> In Stock</label>
          <label class="filter-option"><input type="checkbox"> Pre-Order</label>
        </div>
      </aside>

      <!-- Products Main -->
      <main id="collection-products" aria-label="Products">
        <div class="collection-toolbar">
          <p class="products-count">
            Showing {{ collection.products_count }} gifts
          </p>
          <div style="display:flex;align-items:center;gap:1rem;">
            <select
              class="sort-select"
              aria-label="Sort products"
              onchange="window.location='{{ collection.url }}?sort_by='+this.value"
            >
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                  {{ option.name }}
                </option>
              {%- endfor -%}
            </select>

            <!-- Grid / List Toggle -->
            <div style="display:flex;gap:4px;">
              <button class="nav-icon-btn" aria-label="Grid view" title="Grid view">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
                </svg>
              </button>
            </div>
          </div>
        </div>

        {%- paginate collection.products by 16 -%}
          {%- if collection.products.size == 0 -%}
            <div style="text-align:center;padding:5rem 1rem;">
              <div style="font-size:4rem;margin-bottom:1rem;">🔍</div>
              <h3>No gifts found</h3>
              <p style="color:#888;margin-bottom:1.5rem;">Try adjusting your filters or browse all gifts.</p>
              <a href="/collections/all" class="btn btn-primary">Browse All Gifts</a>
            </div>
          {%- else -%}
            <div class="products-grid">
              {%- for product in collection.products -%}
                {% render 'product-card', product: product %}
              {%- endfor -%}
            </div>

            <!-- Pagination -->
            {%- if paginate.pages > 1 -%}
              <nav aria-label="Pagination" style="margin-top:3rem;display:flex;justify-content:center;gap:0.5rem;flex-wrap:wrap;">
                {%- if paginate.previous -%}
                  <a href="{{ paginate.previous.url }}" class="btn btn-outline btn-sm">← Prev</a>
                {%- endif -%}
                {%- for part in paginate.parts -%}
                  {%- if part.is_link -%}
                    <a href="{{ part.url }}" class="btn btn-outline btn-sm">{{ part.title }}</a>
                  {%- else -%}
                    <span class="btn btn-primary btn-sm" aria-current="page">{{ part.title }}</span>
                  {%- endif -%}
                {%- endfor -%}
                {%- if paginate.next -%}
                  <a href="{{ paginate.next.url }}" class="btn btn-outline btn-sm">Next →</a>
                {%- endif -%}
              </nav>
            {%- endif -%}
          {%- endif -%}
        {%- endpaginate -%}
      </main>
    </div>
  </div>
</div>
